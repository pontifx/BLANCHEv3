{
  "manifest_version": 3,
  "name": "BLANCHE",
  "version": "0.1.0",
  "description": "A modular Chromium inspection platform that exports browser-side visibility into Burp-friendly JSON.",
  "icons": {
    "16": "dist/icons/emu-16.png",
    "32": "dist/icons/emu-32.png",
    "48": "dist/icons/emu-48.png",
    "128": "dist/icons/emu-128.png"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "devtools_page": "dist/devtools.html",
  "permissions": [
    "bookmarks",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "webNavigation",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://blanche.invalid/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "BLANCHE",
    "default_icon": {
      "16": "dist/icons/emu-16.png",
      "32": "dist/icons/emu-32.png",
      "48": "dist/icons/emu-48.png",
      "128": "dist/icons/emu-128.png"
    }
  },
  "minimum_chrome_version": "123",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content/pageInstrumentor.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "css": []
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist/content/bridgeContent.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "css": []
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/content/pageInstrumentor.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
